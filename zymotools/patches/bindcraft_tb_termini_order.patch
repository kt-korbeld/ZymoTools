     self._callbacks["model"]["loss"].append(loss_fn)
     self.opt["weights"]["NC"] = weight
 
+def add_tb_termini_distance_loss(self, weight=0.1, threshold_distance=30, order="binder-target"):
+    '''Add loss penalizing the distance between the target and binder termini that a
+    fusion linker will eventually join. `order` names the intended single-chain fusion
+    order (matching binder_pipeline's `fuse --order`):
+      - "binder-target": binder first, target second -> pulls the binder's C-terminus
+        toward the target's N-terminus.
+      - "target-binder": target first, binder second -> pulls the target's C-terminus
+        toward the binder's N-terminus.
+    '''
+    if order not in ("binder-target", "target-binder"):
+        raise ValueError(
+            "add_tb_termini_distance_loss: order must be 'binder-target' or "
+            "'target-binder', got {!r}".format(order))
+
+    def loss_fn(inputs, outputs):
+        xyz = outputs["structure_module"]
+        ca = xyz["final_atom_positions"][:, residue_constants.atom_order["CA"]]
+        ca_t = ca[:-self._binder_len]  # Considering only the target before _binder_len residues
+        ca_b = ca[-self._binder_len:]  # Considering only the last _binder_len residues
+
+        # Extract N-terminus (first CA atom) and C-terminus (last CA atom) of target
+        n_terminus_t = ca_t[0]
+        c_terminus_t = ca_t[-1]
+        # Extract N-terminus (first CA atom) and C-terminus (last CA atom) of binder
+        n_terminus_b = ca_b[0]
+        c_terminus_b = ca_b[-1]
+
+        # Pick the pair of termini that the fusion linker of `order` would join
+        if order == "binder-target":
+            joined_a, joined_b = c_terminus_b, n_terminus_t
+        else:
+            joined_a, joined_b = c_terminus_t, n_terminus_b
+
+        # Compute the distance between the joined termini
+        termini_distance = jnp.linalg.norm(joined_a - joined_b)
+
+        # Compute the deviation from the threshold distance using ELU activation
+        deviation = jax.nn.elu(termini_distance - threshold_distance)
+
+        # Ensure the loss is never lower than 0
+        termini_distance_loss = jax.nn.relu(deviation)
+        return {"NC-TB": termini_distance_loss}
+
+    # Append the loss function to the model callbacks
+    self._callbacks["model"]["loss"].append(loss_fn)
+    self.opt["weights"]["NC-TB"] = weight
+
